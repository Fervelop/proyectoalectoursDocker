# Backend Configuration - .env.example
# Copia este archivo a .env y llena los valores vacíos

# ============================================================================
# BASE DE DATOS
# ============================================================================
DATABASE_URL=postgresql+psycopg://admin:admin123@postgres:5432/alektours_db

# ============================================================================
# AUTENTICACIÓN JWT
# ============================================================================
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Algoritmo de encriptación
ALGORITHM=HS256

# Expiración de tokens en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# CONFIGURACIÓN DE EMAIL (SMTP)
# ============================================================================
# Para desarrollo: usar Mailpit (puerto 1025)
# Para producción: usar Gmail, SendGrid, AWS SES, etc.

# Usuario/email SMTP
MAIL_USERNAME=

# Contraseña SMTP (app password si usas Gmail)
MAIL_PASSWORD=

# Email de origen
MAIL_FROM=noreply@alectours.com

# Puerto SMTP
# - Mailpit: 1025
# - Gmail: 587 (TLS) o 465 (SSL)
# - SendGrid: 587
MAIL_PORT=1025

# Servidor SMTP
# - Mailpit: mailpit
# - Gmail: smtp.gmail.com
# - SendGrid: smtp.sendgrid.net
MAIL_SERVER=mailpit

# Nombre visible del remitente
MAIL_FROM_NAME=AlecTours

# Usar STARTTLS (requerido en algunos servidores)
MAIL_STARTTLS=False

# Usar SSL/TLS (requerido en algunos servidores)
MAIL_SSL_TLS=False

# ============================================================================
# CONFIGURACIÓN DE DESARROLLO
# ============================================================================
# DEBUG=True
# LOG_LEVEL=DEBUG

# ============================================================================
# NOTAS DE SEGURIDAD
# ============================================================================
# ⚠️  NUNCA commitear este archivo a Git
# ✓  Incluido en .gitignore
# ✓  Crear .env.example sin valores sensibles (para documentación)
# ✓  En producción, usar variables de entorno del servidor/contenedor
# ✓  Generar SECRET_KEY fuerte para producción
